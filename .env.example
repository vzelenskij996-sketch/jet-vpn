# Сервер
PORT=3000
JWT_SECRET=change_this_to_a_long_random_string

# Ваш домен (используется для CORS и вывода в консоль). Пример: https://jetvpn.ru
SITE_URL=https://your-domain.example

# Первый админ (создаётся автоматически при первом запуске, если админов ещё нет)
ADMIN_EMAIL=admin@jetvpn.example
ADMIN_PASSWORD=change_this_password

# Панель 3x-ui — впишите свои данные
XUI_PANEL_URL=https://your-3xui-panel:port
XUI_USERNAME=admin
XUI_PASSWORD=your_xui_password
XUI_INBOUND_ID=1
